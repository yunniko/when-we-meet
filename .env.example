# Copy to .env and fill in. Never commit .env.

# PostgreSQL (matches docker-compose.yml defaults for local dev — host port
# 54321 to avoid clashing with other Company projects, published on
# 127.0.0.1 only)
DATABASE_URL="postgresql://wwm:wwm@127.0.0.1:54321/when_we_meet"

# Production deploys only: the real public URL, used to build absolute
# shareable room links (e.g. "https://when-we-meet.example", no trailing
# slash). Falls back to http://localhost:3000 when unset.
APP_URL=""
