{
  "color": {
    "background": { "$value": "#faf3e6", "$description": "page" },
    "surface": { "$value": "#fffcf5", "$description": "cards and grid cells" },
    "surface-raised": { "$value": "#ffffff" },
    "weekend": { "$value": "#f1e3c9", "$description": "weekend columns in the grid and heatmap" },
    "text": { "$value": "#33261a" },
    "text-muted": { "$value": "#6e5d49", "$description": "was #83705a: 4.29 on the page, under AA" },
    "border": { "$value": "#e6d7bd" },
    "accent": { "$value": "#b8561a", "$description": "was #e0762a: white on it was 3.09" },
    "accent-hover": { "$value": "#9e4815" },
    "on-accent": { "$value": "#ffffff" },
    "danger": { "$value": "#b91c1c" },
    "danger-hover": { "$value": "#991b1b" },
    "on-danger": { "$value": "#ffffff" },
    "danger-soft": { "$value": "#fef2f2", "$description": "background of a destructive panel" },
    "danger-border": { "$value": "#fecaca" },
    "warning": { "$value": "#b54708" },
    "success": { "$value": "#047857" },
    "info": { "$value": "#175cd3" },
    "focus": { "$value": "{color.accent}" },
    "can": { "$value": "#10b981", "$description": "grid: available; heatmap base" },
    "on-can": { "$value": "#022c22" },
    "cannot": { "$value": "#f43f5e", "$description": "grid: not available" },
    "prefer": { "$value": "#fbbf24", "$description": "grid: preferred" },
    "highlight": { "$value": "#fbbf24", "$description": "a time the whole group can make" },
    "prefer-mark": { "$value": "#78350f", "$description": "the star on a preferred cell" }
  },
  "font": {
    "body": { "$value": ["var(--font-geist-sans)", "Arial", "Helvetica", "sans-serif"] },
    "mono": { "$value": ["var(--font-geist-mono)", "monospace"] }
  },
  "fontSize": {
    "2xs": { "$value": "0.625rem", "$description": "marks inside a grid cell only" },
    "xs": { "$value": "0.75rem" },
    "sm": { "$value": "0.875rem" },
    "base": { "$value": "1rem" },
    "lg": { "$value": "1.125rem" },
    "2xl": { "$value": "1.5rem" }
  },
  "space": {
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" }
  },
  "radius": {
    "sm": { "$value": "0.25rem" },
    "md": { "$value": "0.375rem" }
  },
  "shadow": {
    "sm": { "$value": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)", "$extensions": { "dp": 1 } },
    "raised": { "$value": "0 4px 12px rgb(51 38 26 / 0.15)", "$extensions": { "dp": 3 } }
  },
  "duration": { "fast": { "$value": "120ms" }, "normal": { "$value": "200ms" } },
  "contrast": [
    ["text", "background", 4.5],
    ["text", "weekend", 4.5],
    ["text-muted", "background", 4.5],
    ["text-muted", "weekend", 4.5],
    ["accent", "background", 3],
    ["on-danger", "danger", 4.5],
    ["on-danger", "danger-hover", 4.5],
    ["on-accent", "accent-hover", 4.5],
    ["danger", "danger-soft", 4.5],
    ["danger", "background", 4.5],
    ["success", "surface", 4.5],
    ["warning", "surface", 4.5],
    ["on-can", "can", 4.5],
    ["prefer-mark", "prefer", 4.5]
  ]
}
