generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A planning room. Times are never converted between timezones — `timezone`
// is a display label only, and every slot is stored as a plain wall-clock
// (date, hour) pair. This sidesteps DST/UTC-conversion bugs entirely and
// matches the product decision that a room has one implicit timezone that
// everyone marks and views in (see GOALS.md scope decisions, 2026-08-17).
model Room {
  id           String   @id @default(cuid())
  // Unguessable URL token (not the internal id, so ids can stay short/
  // sequential-feeling without making rooms enumerable).
  slug         String   @unique
  title        String?
  // Optional free text the creator can use for context/instructions (e.g.
  // "bring snacks", a location). Never parsed/used by app logic — display
  // only, same trust level as title (rendered as plain text, no markup).
  description  String?
  timezone     String
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  // Daily window applied to every day in [startDate, endDate], in the room's
  // timezone. Defaults to the full day. dayEndHour is exclusive (24 = through
  // 23:00-24:00).
  dayStartHour Int      @default(0)
  dayEndHour   Int      @default(24)
  // Who may join (G-004, D011): ANYONE adds a participant for any unused
  // name; LISTED_ONLY only lets people claim a name the owner pre-added.
  joinRule     JoinRule @default(ANYONE)
  createdAt    DateTime @default(now())

  // Opaque cookie token identifying the browser that created the room (see
  // G-001 trust model — no accounts). Used exactly once: to auto-tag that
  // browser's first joined Participant as `creator` below. After that, the
  // token is inert — creator permissions live on `creatorParticipantId`, not
  // this token, precisely so the creator can recover them on any device by
  // rejoining under the same name (the ordinary name-collision "is this
  // you?" flow) rather than being locked out by losing a cookie.
  ownerToken           String       @unique
  creatorParticipantId String?      @unique
  creator              Participant? @relation("RoomCreator", fields: [creatorParticipantId], references: [id])
  // True once an owner left with nobody joined to inherit the room; the
  // next participant to join or claim a name becomes owner (D011). False on
  // a new room, where only the creating browser's ownerToken claims it.
  ownershipVacant      Boolean      @default(false)

  // The creator's finalized meeting slot, if any. Same wall-clock (date,
  // hour) convention as Availability — never a converted instant. Once set,
  // participant availability marking is locked (see saveAvailability) and
  // this is also what room expiry counts from (see lib/expiry.ts).
  selectedDate DateTime? @db.Date
  selectedHour Int?

  participants Participant[]

  @@index([slug])
}

// A named participant in a room, identified across visits by a random
// cookie token (no password — see G-001 trust model). `nameKey` is the
// normalized (trimmed, lowercased) name, unique per room, used to detect the
// "this name already exists — is this you?" case.
model Participant {
  id          String    @id @default(cuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name        String
  nameKey     String
  cookieToken String    @unique
  // When a browser first joined as (or claimed) this participant. Null marks
  // a name the owner pre-added that nobody has claimed yet (G-004, D011);
  // such a row's cookieToken is held by no browser.
  joinedAt    DateTime?
  // Set when a participant leaves a "listed names only" room and the name
  // goes back to unclaimed; cleared when it is claimed again. Lets the owner
  // tell "left" from "never joined" (D013).
  leftAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  availability Availability[]
  // Back-relation for Room.creator — at most one Room can point to a given
  // Participant as its creator (enforced by Room.creatorParticipantId being
  // @unique).
  createdRoom  Room?          @relation("RoomCreator")

  @@unique([roomId, nameKey])
}

enum AvailabilityStatus {
  CAN
  CANNOT
}

enum JoinRule {
  ANYONE
  LISTED_ONLY
}

// One 1-hour slot mark for a participant. No row = unknown (not "cannot").
// `preferred` is only meaningful when status is CAN; enforced in application
// code, not the schema.
model Availability {
  id            String             @id @default(cuid())
  participantId String
  participant   Participant        @relation(fields: [participantId], references: [id], onDelete: Cascade)
  slotDate      DateTime           @db.Date
  slotHour      Int
  status        AvailabilityStatus
  preferred     Boolean            @default(false)

  @@unique([participantId, slotDate, slotHour])
  @@index([participantId])
}
